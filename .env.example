# Copy to .env and fill in. NEVER commit real values (.env is gitignored).
# This file documents the SHAPE of required secrets only.

# --- LaunchDarkly: FACTORY / control-plane project ---
# Holds the agent AI configs, the agent graph, and operational flags
# (auto-factory-ai-provider, the approval-mode/risk-threshold/gates trio). The
# prototype READS from here.
#
# Server SDK key (sdk-...) for the factory project's environment. Used by the
# Node server SDK (flag evaluation) + AI SDK (agent configs + agent graphs).
LD_SDK_KEY=
# API key (api-...) for REST operations (e.g. creating flags in the app project).
LD_API_KEY=
# REST API base URL.
LD_BASE_URL=https://app.launchdarkly.com
# Factory/control-plane project key (where AI configs + graph + control flags live).
LD_PROJECT_KEY=
# Internal LaunchDarkly project ID (NOT the project key). Sent as Vega dispatch
# `project_slug`. Find it via the Vega/observability API; falls back to LD_PROJECT_KEY.
LD_PROJECT_SLUG=

# --- Anthropic (DEFAULT agent execution backend) ---
# Required when the `auto-factory-ai-provider` flag serves 'anthropic' (the
# default, also used when the flag does not exist). The local Anthropic runner
# uses each AI config's instructions as the agent system prompt. Only optional
# if the provider flag is set to 'vega'.
ANTHROPIC_API_KEY=

# --- Cursor (agent execution backend; only when the provider flag serves 'cursor') ---
# Required when `auto-factory-ai-provider` serves 'cursor'. Each graph node runs as
# one Cursor agent (@cursor/sdk). The model + parameters are derived from the LD AI
# config; inference runs on Cursor's hosted models. Needs Node >=22.13 at runtime.
CURSOR_API_KEY=
# Fallback Cursor model id used ONLY when the LD AI config's model can't be matched
# to Cursor's catalog (e.g. 'auto' or 'composer-2.5'). Leave blank to default to 'auto'.
CURSOR_MODEL=

# --- LLM Observability ---
# Per-agent LLM calls are emitted as gen_ai OpenTelemetry spans.
#
# LaunchDarkly LLM Observability (via @launchdarkly/observability-node) is ON by
# default alongside Sentry when both are configured (dual-write, ADR 0014).
# DISABLE_LD_OBSERVABILITY=true   # cut over: stop exporting agent spans to LD
# LD_OBSERVABILITY_SERVICE=auto-factory-phase1   # OTel service.name (default shown)
#
# Sentry AI agent monitoring (factory runners — separate project from app errors):
# SENTRY_DSN=                     # factory / AutoFactory runners project DSN
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_AI_RECORD_PROMPTS=true   # opt-in: capture prompts/completions (off by default)
# SENTRY_SERVICE_NAME=auto-factory-phase1

# --- Knowledge graph (auto-factory-knowledge-graph flag, ADR 0010) ---
# When the flag is on, the run composes service edges from observability traces
# via the hosted o11y MCP endpoint (auth: Bearer <LD_API_KEY>). Optional overrides:
# LD_O11Y_MCP_URL=https://mcp.launchdarkly.com/mcp/observability   # default shown
# LD_O11Y_AUTH=            # full Authorization header value, if the scheme changes

# --- LaunchDarkly: APP / data-plane project ---
# Where agents auto-CREATE feature flags and where Phase 2 auto-releases them.
# Kept separate from the factory project for blast-radius isolation.
# Bootstrap also provisions shared Sentry-backed metrics (sentry-errors-*) here.
LD_APP_PROJECT_KEY=autofactory-demo

# --- LaunchDarkly source (optional): where to pull initial configs + graphs from ---
# Design partners may seed from the shared "auto-factory-prototype" project.
# Leave blank to provision straight from the canonical local copies in the repo.
LD_SOURCE_API_KEY=
LD_SOURCE_BASE_URL=
LD_SOURCE_PROJECT_KEY=

# --- Vega (Phase 1 agent dispatch; only when the provider flag serves 'vega') ---
# NOTE: the Agent Dispatch API must be enabled for the project via a LaunchDarkly
# flag / entitlement before Vega dispatch works at all.
# GraphQL endpoint for dispatching agents (deployment-specific). If unset, the
# action uses a no-op stub transport.
VEGA_ENDPOINT=
# Auth is a regular LaunchDarkly API key sent raw in the Authorization header.
# Leave VEGA_TOKEN blank to reuse LD_API_KEY.
VEGA_TOKEN=
# Optional: override the auth header name if the endpoint expects a non-standard one.
VEGA_AUTH_HEADER=

# --- Phase 1 behavior toggles (read from env / action inputs) ---
# Master switches for what the agents are allowed to do. All optional; the
# defaults below are read-only/dry-run-safe.
#
# 'true' lets the flag-implementer create REAL flags in the app project (needs
# LD_API_KEY + LD_APP_PROJECT_KEY). 'false' = read-only dry run.
ENABLE_FLAG_CREATION=false
# 'true' lets agents edit files and commit+push to the PR branch (needs a token
# with contents:write). 'false' = no writes to the repo.
ENABLE_CODE_CHANGES=false
# Approval policy OVERRIDE. Leave unset: the auto-factory-approval-mode /
# -risk-threshold / -approval-gates flags are the control plane (ADR 0008), and
# setting this env var SILENTLY OVERRIDES them (it once bypassed mode=always in a
# live run). Only set it for a deliberate local experiment:
# yolo (no gates) | risk-threshold (gate steps when the planner's risk_score
# meets RISK_THRESHOLD) | always (gate the configured steps every run).
# Legacy values middle/manual are accepted and mapped.
# APPROVAL_MODE=yolo
# Agent graph key to resolve from LaunchDarkly and walk. Default gha-auto-factory.
GRAPH_KEY=gha-auto-factory
# Repo path the agent tools inspect/edit. Defaults to examples/demo-app locally,
# "." (the checked-out workspace) in CI.
SANDBOX_ROOT=
# Vega dispatch request type / persona (e.g. Fix). Only used on the Vega path.
VEGA_REQUEST_TYPE=
# Key for the STATIC `service`-kind context (flag eval + AI config/graph targeting;
# operational flags target this). Keep it stable. The run context is a SEPARATE
# `run` kind with a fresh UUID per run (the per-run experiment randomization unit) —
# minted automatically, not configured here. Default auto-factory-phase1.
LD_PIPELINE_CONTEXT_KEY=auto-factory-phase1

# --- GitHub (Phase 1 GitHub Action) ---
GITHUB_TOKEN=

# --- Railway (Phase 2 CD; only if your demo services deploy on Railway) ---
RAILWAY_TOKEN=

# --- Beacon (Phase 2 orchestrator) ---
# Shared secret every deploy notification must present (x-beacon-secret header
# or ?secret= query parameter).
BEACON_WEBHOOK_SECRET=
# LD environment releases target when a notification omits one. Default production.
LD_ENVIRONMENT_KEY=
# Deploy-state store file (last/prior SHA per service). Default beacon-state.json.
BEACON_STATE_FILE=
# Release monitoring: 'false' disables; poll/timeout in ms (defaults 10s / 24h).
BEACON_MONITOR=
BEACON_MONITOR_POLL_MS=
BEACON_MONITOR_TIMEOUT_MS=

# --- Sentry estate API (Phase 1 query_sentry + Beacon Seer; ADR 0014 / 0015) ---
# Same token family for Metrics Author `query_sentry` (project:read + event:read)
# and optional Seer Autofix on revert (event:write / Seer entitlement). A token
# missing read scopes makes Beacon log HTTP 403 — not a false "no matching issue".
# Point ORG/PROJECT at the *app* Sentry project (production errors), not the
# factory runners DSN above. Soft when unset — empty estate picture + warning.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_API_BASE=https://sentry.io
#
# --- Seer Autofix on guarded-release revert (ADR 0014) ---
# When a release ends REVERTED, Beacon can find a related Sentry issue and start
# Seer Autofix (stopping_point open_pr by default). Off until explicitly enabled.
# BEACON_SEER_AUTOFIX=true
# BEACON_SEER_STOPPING_POINT=open_pr   # root_cause | solution | code_changes | open_pr
